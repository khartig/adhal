{
  "name": "@ad-hal/cli",
  "version": "0.1.2",
  "description": "Adhal command-line tools: send and receive a file directly between two machines with a one-shot code.",
  "keywords": [
    "p2p",
    "file-transfer",
    "cli",
    "pake",
    "hyperswarm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khartig/adhal.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/khartig/adhal#readme",
  "bugs": {
    "url": "https://github.com/khartig/adhal/issues"
  },
  "files": [
    "src",
    "!src/send.js",
    "!src/receive.js",
    "!src/demo-*.js"
  ],
  "bin": {
    "ad-hal-send": "src/swarm-send.js",
    "ad-hal-receive": "src/swarm-receive.js",
    "ad-hal-code": "src/code.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "test:fast": "ADHAL_FAST=1 node --test",
    "fuzz": "ADHAL_FUZZ_ITERATIONS=100000 node --test --test-timeout=1800000 test/fuzz.test.js"
  },
  "dependencies": {
    "@ad-hal/engine": "workspace:*",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "hyperdht": "6.34.0",
    "jsqr": "1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
