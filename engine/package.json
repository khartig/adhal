{
  "name": "@ad-hal/engine",
  "version": "0.1.1",
  "description": "The Adhal transfer engine: a CPace-authenticated, sealed, one-shot file drop between two peers over Hyperswarm.",
  "keywords": [
    "p2p",
    "file-transfer",
    "pake",
    "cpace",
    "hyperswarm",
    "hole-punching"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khartig/adhal.git",
    "directory": "engine"
  },
  "homepage": "https://github.com/khartig/adhal#readme",
  "bugs": {
    "url": "https://github.com/khartig/adhal/issues"
  },
  "files": [
    "src"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "b4a": "1.9.0",
    "hypercore-crypto": "3.7.0",
    "hyperdht": "6.34.0",
    "hyperswarm": "4.17.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
